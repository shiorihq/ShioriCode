{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist-electron/**"],
    },
    "dev": {
      // dev-desktop.mjs already starts the server's watch build and waits for
      // its output. A full server build here duplicated that work on every
      // launch and kept Electron off-screen for several seconds.
      "dependsOn": [],
      "persistent": true,
    },
    "start": {
      "dependsOn": ["build", "web#build", "shioricode#build"],
      "cache": false,
      "persistent": true,
    },
    "smoke-test": {
      "dependsOn": ["build", "web#build", "shioricode#build"],
      "cache": false,
      "outputs": [],
    },
  },
}
